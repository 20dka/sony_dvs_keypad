#include "font5x7.h"
#include "drive_hdsp.h"

//#define VERBOSE

// number of 74xx164 chips used for driving button matrix rows _per board_
#define ROW_CHIPS 1
#define ROW_COUNT (ROW_CHIPS*8)

// _total_ number of 74xx166 chips on bus(ex: Key Frame control [3] + Numeric keypad [2])
#define OUTPUT_REGISTER_COUNT 5


typedef union keypad_data_t {
  struct {
    uint8_t parity0;
    uint8_t enc0_low;
    uint8_t :8;
    uint8_t parity1;
    uint8_t :16;
    uint8_t enc0_high;
    uint8_t :40;
    uint8_t btn0_0;
    uint8_t :32;
    uint8_t btn0_1;
    uint8_t :8;
    uint8_t btn1_0;
    uint8_t :32;
    uint8_t btn1_1;
    uint8_t :32;
    uint8_t btn1_2;
    uint8_t :32;
    uint8_t btn1_3;
    uint8_t :16;
    uint8_t btn0_2;
    uint8_t :8;
    uint8_t btn1_4;
  }__attribute__((packed)) fields;
  uint8_t arr[OUTPUT_REGISTER_COUNT*ROW_COUNT];
} keypad_data_t;

keypad_data_t data;

void setup_keypad_io();
void flush_row_reg();

void setup() {
  //Serial.begin(115200);
  //Serial.println("\nHello :) Sony DVS Keypad MIDI interface :)");
  setup_keypad_io();
  setup_screen_io();

  flush_row();
  flush_column();
  flush_row_reg();
}

