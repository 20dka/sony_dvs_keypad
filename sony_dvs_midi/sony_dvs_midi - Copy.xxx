void loop() {
  static uint32_t keypad_update_idx_last = 0;
  uint32_t keypad_update_idx = millis() / 200;
  if (keypad_update_idx > keypad_update_idx_last) {
    keypad_update_idx_last = keypad_update_idx;
    //midi_stuff();
  }

  //MidiUSB.flush();
  noInterrupts();
  update_screen();
  interrupts();
}
